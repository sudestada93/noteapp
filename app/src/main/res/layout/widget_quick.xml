<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="serif"
        android:text="Libreta"
        android:textColor="#1F1B16"
        android:textSize="20sp" />

    <ImageView android:id="@+id/w_note" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="6dp"
        android:background="@drawable/widget_btn_blue" android:padding="10dp" android:src="@drawable/ic_w_add" android:contentDescription="Nueva nota" />
    <ImageView android:id="@+id/w_task" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="6dp"
        android:background="@drawable/widget_btn_mint" android:padding="10dp" android:src="@drawable/ic_w_check" android:contentDescription="Nueva tarea" />
    <ImageView android:id="@+id/w_audio" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="6dp"
        android:background="@drawable/widget_btn_coral" android:padding="10dp" android:src="@drawable/ic_w_mic" android:contentDescription="Audio" />
    <ImageView android:id="@+id/w_camera" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="6dp"
        android:background="@drawable/widget_btn_yellow" android:padding="10dp" android:src="@drawable/ic_w_camera" android:contentDescription="Foto" />
    <ImageView android:id="@+id/w_search" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="6dp"
        android:background="@drawable/widget_btn_white" android:padding="10dp" android:src="@drawable/ic_w_search" android:contentDescription="Buscar" />
</LinearLayout>
